# Vercel env vars — set these in Vercel dashboard, NOT in this file in production
# Local dev: copy to .env (which is gitignored)

# Zapier webhook URL (from Zapier "Catch Hook" trigger)
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/XXXXXXX/YYYYYY/

# Google Analytics 4 measurement ID
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Ads conversion tracking
PUBLIC_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXXX
PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=XXXXXXXXX
