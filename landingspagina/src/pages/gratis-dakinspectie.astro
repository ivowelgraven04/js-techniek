---
import BaseLayout from '~/layouts/BaseLayout.astro';
import TopBar from '~/components/TopBar.astro';
import HeroSplit from '~/components/HeroSplit.astro';
import UspStrip from '~/components/UspStrip.astro';
import TestimonialGrid from '~/components/TestimonialGrid.astro';
import ServiceAreaBlock from '~/components/ServiceAreaBlock.astro';
import FaqAccordion from '~/components/FaqAccordion.astro';
import CtaBlock from '~/components/CtaBlock.astro';
import StickyMobileCta from '~/components/StickyMobileCta.astro';
import Footer from '~/components/Footer.astro';
import QuizFunnel from '~/components/QuizFunnel.astro';
import heroImage from '~/assets/images/hero-plat-dak.jpeg';
import { company, seo, testimonialsLekkage, faqDakinspectie } from '~/data/site';

const SOURCE_PAGE = '/gratis-dakinspectie';

const uspItems = [
  {
    iconPath: '<path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>',
    title: 'Eigen vakmensen',
    text: 'Geen onderaannemers. Vaste ploeg uit Noord-Holland, al 25+ jaar.',
  },
  {
    iconPath: '<path d="M9 12l2 2 4-4M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9c2.39 0 4.68.94 6.36 2.64"/>',
    title: `${company.warrantyYearsBitumen} jaar garantie op bitumen werk`,
    text: 'Schriftelijk vastgelegd. Materiaal én uitvoering.',
  },
  {
    iconPath: '<path d="M9 7h6m-6 4h6m-6 4h6M5 21h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2z"/>',
    title: 'Vaste prijsopgave vóór start',
    text: 'Geen verrassingen achteraf. Eerlijk advies, ook als renovatie niet nodig is.',
  },
];

const processSteps = [
  {
    n: 1,
    title: 'Vul in 30 seconden de aanvraag in',
    text: 'Drie korte vragen. Geen verplichtingen, geen contract.',
  },
  {
    n: 2,
    title: 'Wij bellen u binnen 1 werkdag',
    text: 'Korte belafspraak om uw situatie te bespreken en een moment in te plannen.',
  },
  {
    n: 3,
    title: 'Gratis inspectie op locatie',
    text: 'Eigen vakman komt langs, bekijkt het dak en u krijgt een vaste prijsopgave op papier.',
  },
];
---
<BaseLayout
  title={seo.dakinspectie.title}
  description={seo.dakinspectie.description}
  ogImage="/og-plat-dak.jpg"
>
  {/* Meta Pixel — page-scoped, fires PageView on load. Lead event fires from QuizFunnel before redirect. */}
  <script is:inline>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '3056730661197575');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=3056730661197575&ev=PageView&noscript=1" alt="" /></noscript>

  <TopBar ctaText="Plan inspectie" ctaHref="#stap-1" />

  <main>
    <!-- ─── MODE A — Landing hero ─── -->
    <section id="hero-mode">
      <HeroSplit
        eyebrow="Gratis dakinspectie · Noord-Holland"
        title="Vermoeden van dakproblemen? Plan een gratis dakinspectie op locatie."
        subtitle={`Eigen vakmensen langs binnen 1 werkdag. Vaste prijsopgave vóór start. ${company.warrantyYearsBitumen} jaar garantie. Geen verplichtingen.`}
        bullets={[
          '<strong>Gratis & vrijblijvend</strong> — geen voorrijkosten, geen druk',
          `<strong>${company.projectsCount.toLocaleString('nl-NL')}+ daken</strong> in Noord-Holland sinds ${new Date().getFullYear() - company.yearsActive}`,
          '<strong>Eigen ploeg</strong>, geen onderaannemers',
        ]}
        primaryCta={{ text: 'Vraag gratis dakinspectie', href: '#stap-1', trackId: 'hero-quiz-open' }}
        secondaryCta={{ text: `Of bel: ${company.phoneDisplay}`, href: `tel:${company.phoneRaw}`, trackId: 'hero-phone' }}
        photo={heroImage}
        photoAlt="Dakdekker op plat dak in Noord-Holland, bezig met bitumen werk"
        showGoogleBadge={true}
        badge={`${company.projectsCount.toLocaleString('nl-NL')}+ daken in NH`}
      />
    </section>

    <!-- ─── MODE B — Quiz (verborgen tot CTA-klik) ─── -->
    <QuizFunnel sourcePage={SOURCE_PAGE} />

    <!-- ─── Trust stack (altijd zichtbaar) ─── -->
    <UspStrip items={uspItems} />

    <!-- "Zo werkt het" - 3-step proces (twijfels wegnemen) -->
    <section class="bg-brand-paper">
      <div class="container-content section">
        <div class="text-center max-w-2xl mx-auto">
          <span class="eyebrow">Zo werkt het</span>
          <h2 class="text-h2 text-brand-blue-900 mt-3">Drie stappen, geen verplichting</h2>
          <p class="mt-4 text-brand-blue-900/75 text-lg">
            Van aanvraag tot inspectie op locatie — helder, op uw moment, zonder druk.
          </p>
        </div>
        <ol class="mt-12 grid md:grid-cols-3 gap-6">
          {processSteps.map(step => (
            <li class="bg-white rounded-3xl border border-gray-100 shadow-brand p-7 flex flex-col gap-4">
              <span class="w-12 h-12 rounded-2xl bg-brand-yellow-500 text-brand-ink font-extrabold text-xl flex items-center justify-center">
                {step.n}
              </span>
              <h3 class="text-h3 text-brand-blue-900">{step.title}</h3>
              <p class="text-brand-blue-900/75">{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <TestimonialGrid items={testimonialsLekkage} />

    <ServiceAreaBlock />

    <FaqAccordion items={faqDakinspectie} />

    <CtaBlock
      title="Klaar om uw dak te laten checken?"
      subtitle="Drie korte vragen, daarna belt JS Techniek u binnen 1 werkdag voor het inplannen."
      primaryCta={{ text: 'Vraag gratis dakinspectie', href: '#stap-1', trackId: 'final-quiz-open' }}
      secondaryCta={{ text: `Of bel: ${company.phoneDisplay}`, href: `tel:${company.phoneRaw}`, trackId: 'final-phone' }}
    />

    <Footer />
  </main>

  <StickyMobileCta variant="phone" />

  <script>
    // ─── Mode-controller: A (landing) ↔ B (quiz) ────────────────
    const heroMode = document.getElementById('hero-mode');
    const quizMode = document.getElementById('quiz-mode');

    function openQuiz(opts: { resume?: boolean } = {}) {
      if (!heroMode || !quizMode) return;
      heroMode.hidden = true;
      quizMode.hidden = false;
      window.dispatchEvent(new CustomEvent('dakinspectie:open-quiz', { detail: opts }));
    }

    function closeQuiz() {
      if (!heroMode || !quizMode) return;
      quizMode.hidden = true;
      heroMode.hidden = false;
      // Verwijder hash zonder navigation
      if (window.location.hash.startsWith('#stap-')) {
        history.pushState({}, '', window.location.pathname + window.location.search);
      }
      heroMode.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // Intercept alle CTA-klikken die naar #stap-1 willen → open quiz
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const link = target?.closest?.('a[href^="#stap-"]') as HTMLAnchorElement | null;
      if (!link) return;
      e.preventDefault();
      openQuiz();
    });

    // Quiz-close event vanuit QuizFunnel (back op stap 1)
    window.addEventListener('dakinspectie:close-quiz', closeQuiz);

    // Initial: als pagina laadt met #stap-X in URL → open quiz direct
    if (window.location.hash.match(/^#stap-[1-3]$/)) {
      openQuiz({ resume: true });
    }
  </script>
</BaseLayout>
