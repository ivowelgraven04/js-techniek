---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
}

const { title, description, canonical, ogImage = '/og-default.jpg' } = Astro.props;
const siteUrl = 'https://www.jschoutentechniek.com';
const canonicalUrl = canonical ?? `${siteUrl}${Astro.url.pathname}`;
const ga4Id = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;
const adsId = import.meta.env.PUBLIC_GOOGLE_ADS_CONVERSION_ID;
const phoneConvLabel = import.meta.env.PUBLIC_GOOGLE_ADS_PHONE_CONVERSION_LABEL;
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="facebook-domain-verification" content="2x9ayznt8tqjx22exapcutxuyopzek" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#104080" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:locale" content="nl_NL" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Inter font (fast CDN) -->
    <link rel="preconnect" href="https://rsms.me/" crossorigin />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />

    <!-- GA4 (laadt alleen als ID is gezet) -->
    {ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script is:inline define:vars={{ ga4Id, adsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', ga4Id, { anonymize_ip: true });
          if (adsId) gtag('config', adsId);
        </script>
      </>
    )}
  </head>
  <body>
    <slot />

    {/* DPD funnel tracking — session-id + beacon-tracker, gedeeld door alle LP's */}
    <script is:inline>
      (function () {
        var TRACKED = ['gratis-dakinspectie', 'plat-dak-vervangen', 'lekkage-spoed'];
        var SESSION_KEY = 'dpd-session-v1';
        var slug = (location.pathname.replace(/^\/+/, '').split('/')[0] || '').toLowerCase();
        if (TRACKED.indexOf(slug) === -1) return; // alleen op getrackte LP's

        function sid() {
          try {
            var existing = sessionStorage.getItem(SESSION_KEY);
            if (existing) return existing;
            var fresh = (crypto.randomUUID && crypto.randomUUID()) ||
              (Date.now() + '-' + Math.random().toString(36).slice(2));
            sessionStorage.setItem(SESSION_KEY, fresh);
            return fresh;
          } catch (e) { return Date.now() + '-' + Math.random().toString(36).slice(2); }
        }

        function utm() {
          var u = new URL(location.href);
          var out = {};
          ['utm_source','utm_medium','utm_campaign','utm_content','utm_term','gclid'].forEach(function(k){
            var v = u.searchParams.get(k); if (v) out[k] = v;
          });
          return out;
        }

        window.dpdSession = { id: sid(), lpSlug: slug };
        window.dpdTrack = function (eventType, extra) {
          if (!eventType) return;
          var payload = Object.assign({
            session_id: window.dpdSession.id,
            event_type: eventType,
            landing_page_slug: window.dpdSession.lpSlug,
            user_agent: navigator.userAgent,
            referrer: document.referrer || null,
          }, utm(), extra || {});
          try {
            var blob = new Blob([JSON.stringify(payload)], { type: 'application/json' });
            if (navigator.sendBeacon && navigator.sendBeacon('/api/track-event', blob)) return;
          } catch (e) {}
          try {
            fetch('/api/track-event', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload), keepalive: true,
            }).catch(function () {});
          } catch (e) {}
        };

        // Auto: page_view bij eerste laden
        window.dpdTrack('page_view');

        // Auto-detect klik-tracking:
        // 1) Expliciete data-track-event="..." → vuur dat event
        // 2) Of: tel:-link → phone_click
        // 3) Of: wa.me / whatsapp link → whatsapp_click
        // Zo hoeven we niet elk individueel tel:/wa.me-element handmatig te taggen.
        document.addEventListener('click', function (e) {
          var t = e.target;
          if (!t || typeof t.closest !== 'function') return;
          var explicit = t.closest('[data-track-event]');
          if (explicit) {
            window.dpdTrack(explicit.getAttribute('data-track-event'));
            return;
          }
          var link = t.closest('a[href]');
          if (!link) return;
          var href = (link.getAttribute('href') || '').toLowerCase();
          if (href.indexOf('tel:') === 0) {
            window.dpdTrack('phone_click');
          } else if (href.indexOf('wa.me/') !== -1 || href.indexOf('whatsapp.com') !== -1 || href.indexOf('api.whatsapp') !== -1) {
            window.dpdTrack('whatsapp_click');
          }
        });
      })();
    </script>

    {/* Google Ads conversie-tracking voor klikken op tel: links (alle LP's) */}
    {adsId && phoneConvLabel && (
      <script is:inline define:vars={{ adsId, phoneConvLabel }}>
        document.addEventListener('click', function (e) {
          var t = e.target;
          if (!t || typeof t.closest !== 'function') return;
          var link = t.closest('a[href^="tel:"]');
          if (!link) return;
          if (typeof window.gtag !== 'function') return;
          window.gtag('event', 'conversion', {
            send_to: adsId + '/' + phoneConvLabel,
            value: 1.0,
            currency: 'EUR'
          });
        });
      </script>
    )}
  </body>
</html>
