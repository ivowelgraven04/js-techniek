---
import { company } from '~/data/site';
import { Image } from 'astro:assets';
import logo from '~/assets/images/logo.png';

interface Props {
  /** Primary right-side CTA, different per LP. */
  ctaText?: string;
  ctaHref?: string;
}
const { ctaText = 'Gratis offerte', ctaHref = '#offerte' } = Astro.props;
---
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-gray-100">
  <div class="container-content flex items-center justify-between gap-4 py-3">
    <a href="/" class="flex items-center gap-3 shrink-0" aria-label="JS Techniek home">
      <Image src={logo} alt="JS Techniek logo" width={44} height={44} class="h-11 w-11 rounded-full" loading="eager" />
      <span class="hidden sm:inline font-extrabold tracking-tight text-brand-blue-900 text-lg">JS Techniek</span>
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href={`tel:${company.phoneRaw}`}
        class="hidden sm:inline-flex items-center gap-2 font-bold text-brand-blue-900 hover:text-brand-blue-700"
        data-cta="topbar-phone"
        data-track-event="phone_click"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.774a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.06-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
        </svg>
        <span>{company.phoneDisplay}</span>
      </a>

      <a
        href={`https://wa.me/${company.whatsappRaw}?text=${encodeURIComponent('Hallo, ik heb een vraag over mijn platte dak.')}`}
        target="_blank"
        rel="noopener"
        class="hidden sm:inline-flex items-center gap-2 font-semibold text-green-700 hover:text-green-800"
        aria-label="WhatsApp"
        data-cta="topbar-whatsapp"
        data-track-event="whatsapp_click"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zM6.597 20.347c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/>
        </svg>
        <span class="hidden md:inline">WhatsApp</span>
      </a>

      <a href={ctaHref} class="btn-primary text-sm sm:text-base py-3 px-4 sm:px-6" data-cta="topbar-cta">{ctaText}</a>
    </div>
  </div>
</header>
