---
import { company } from '~/data/site';
interface Props {
  variant?: 'phone' | 'form';
  formHref?: string;
}
const { variant = 'phone', formHref = '#offerte' } = Astro.props;
---
{variant === 'phone' ? (
  <a
    href={`tel:${company.phoneRaw}`}
    class="lg:hidden fixed bottom-5 right-5 z-50 w-16 h-16 rounded-full bg-brand-yellow-500 text-brand-ink shadow-fab flex items-center justify-center hover:bg-brand-yellow-600 active:scale-95 transition"
    aria-label={`Bel ${company.phoneDisplay}`}
    data-cta="sticky-fab-phone"
  >
    <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
      <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.774a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.06-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
    </svg>
  </a>
) : (
  <a
    href={formHref}
    class="lg:hidden fixed bottom-5 right-5 z-50 px-5 h-14 rounded-full bg-brand-yellow-500 text-brand-ink font-extrabold shadow-fab flex items-center gap-2 hover:bg-brand-yellow-600 active:scale-95 transition"
    data-cta="sticky-fab-form"
  >
    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
      <path d="M3 4a2 2 0 012-2h10a2 2 0 012 2v12a2 2 0 01-2 2H5a2 2 0 01-2-2V4zm9 2a1 1 0 10-2 0v4a1 1 0 102 0V6zm-1 7a1 1 0 100 2 1 1 0 000-2z"/>
    </svg>
    Gratis offerte
  </a>
)}
