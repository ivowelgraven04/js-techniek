---
import type { Testimonial } from '~/data/site';
import { company } from '~/data/site';

interface Props {
  eyebrow?: string;
  title?: string;
  items: Testimonial[];
}
const { eyebrow = 'Wat klanten zeggen', title = `${company.reviewsRating} sterren op Google`, items } = Astro.props;
---
<section class="bg-brand-paper">
  <div class="container-content section">
    <div class="text-center max-w-2xl mx-auto mb-12">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <div class="flex items-center justify-center gap-3 mt-3">
        <svg class="w-8 h-8 shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        <h2 class="text-h2 text-brand-blue-900">{title}</h2>
      </div>
      <div class="flex justify-center gap-1 mt-4" aria-label={`${company.reviewsRating} sterren`}>
        {Array.from({ length: 5 }).map(() => (
          <svg class="w-7 h-7 text-brand-yellow-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.957a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.367 2.447a1 1 0 00-.363 1.118l1.286 3.957c.3.921-.755 1.688-1.54 1.118l-3.366-2.447a1 1 0 00-1.176 0l-3.367 2.447c-.784.57-1.838-.197-1.539-1.118l1.286-3.957a1 1 0 00-.363-1.118L2.07 9.384c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.95-.69l1.286-3.957z"/>
          </svg>
        ))}
      </div>
      <p class="text-sm text-brand-blue-900/60 mt-2">{company.reviewsCount}+ reviews op Google</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {items.map(t => (
        <figure class="bg-white rounded-3xl p-7 shadow-brand/30 border border-gray-100">
          <div class="flex gap-1 mb-4" aria-label="5 sterren">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-5 h-5 text-brand-yellow-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.957a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.367 2.447a1 1 0 00-.363 1.118l1.286 3.957c.3.921-.755 1.688-1.54 1.118l-3.366-2.447a1 1 0 00-1.176 0l-3.367 2.447c-.784.57-1.838-.197-1.539-1.118l1.286-3.957a1 1 0 00-.363-1.118L2.07 9.384c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.95-.69l1.286-3.957z"/>
              </svg>
            ))}
          </div>
          <blockquote class="text-brand-ink text-lg leading-relaxed">"{t.quote}"</blockquote>
          <figcaption class="mt-5 text-sm text-brand-blue-900/70">
            <span class="font-bold text-brand-blue-900">{t.name}</span>
            <span>, {t.location}</span>
            {t.date && <span class="text-brand-blue-900/50"> · {t.date}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
