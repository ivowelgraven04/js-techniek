---
import { company } from '~/data/site';
---
<footer class="bg-brand-blue-900 text-white/85">
  <div class="container-content py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
      <div>
        <div class="font-extrabold text-2xl text-white">JS Techniek</div>
        <p class="mt-3 text-sm leading-relaxed">
          Specialist bitumen platte daken, zinkwerk en loodwerk in Noord-Holland.
          Werkgebied: Den Helder, Schagen, Wieringen en omstreken.
        </p>
        <div class="mt-4 text-sm">
          <div>KvK: <span class="font-mono">{company.kvk}</span></div>
        </div>
      </div>

      <div>
        <h3 class="font-bold text-white text-lg mb-3">Contact</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={`tel:${company.phoneRaw}`} class="hover:text-brand-yellow-500" data-cta="footer-phone">
              📞 {company.phoneDisplay}
            </a>
          </li>
          <li>
            <a href={`mailto:${company.email}`} class="hover:text-brand-yellow-500">
              ✉️ {company.email}
            </a>
          </li>
          <li>
            <a
              href={`https://wa.me/${company.whatsappRaw}`}
              target="_blank"
              rel="noopener"
              class="hover:text-brand-yellow-500"
              data-cta="footer-whatsapp"
            >
              💬 WhatsApp
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-white/15 flex flex-col sm:flex-row justify-between gap-4 text-xs text-white/60">
      <div>© {new Date().getFullYear()} JS Techniek. Alle rechten voorbehouden.</div>
      <div class="flex gap-5">
        <a href="/privacy" class="hover:text-brand-yellow-500">Privacy</a>
      </div>
    </div>
  </div>
</footer>
