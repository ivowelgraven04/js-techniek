---
import { company } from '~/data/site';
---
<section class="bg-brand-blue-900 text-white relative overflow-hidden">
  <div class="container-content py-16 md:py-20 relative z-10">
    <div class="grid lg:grid-cols-5 gap-10 items-center">
      <div class="lg:col-span-3">
        <span class="inline-flex items-center gap-2 bg-brand-yellow-500 text-brand-ink font-bold px-4 py-1.5 rounded-full text-sm">
          <span class="w-2 h-2 rounded-full bg-red-600 animate-pulse"></span>
          SPOEDLIJN
        </span>
        <h2 class="text-h2 mt-4 leading-tight">
          Lekkage nu? <br class="hidden sm:inline" />
          We bellen u binnen <span class="text-brand-yellow-500">{company.emergencyResponseMinutes} minuten</span> terug.
        </h2>
        <p class="mt-5 text-lg text-white/80 max-w-xl">
          Bij acute lekkage komt elke minuut aan. Bel direct of stuur een WhatsApp met foto.
          We zijn vaak nog dezelfde dag op locatie in Den Helder en omstreken.
        </p>
      </div>

      <div class="lg:col-span-2 lg:justify-self-end w-full">
        <div class="bg-white text-brand-ink rounded-3xl p-7 shadow-brand">
          <div class="text-sm font-bold text-brand-blue-700 uppercase tracking-widest">Direct hulp</div>
          <a
            href={`tel:${company.phoneRaw}`}
            class="block mt-2 text-3xl md:text-4xl font-extrabold text-brand-blue-900 hover:text-brand-blue-700"
            data-cta="emergency-phone"
          >
            {company.phoneDisplay}
          </a>
          <a
            href={`https://wa.me/${company.whatsappRaw}?text=${encodeURIComponent('Spoed: lekkage in mijn platte dak. Adres: ...')}`}
            target="_blank"
            rel="noopener"
            class="mt-5 w-full btn-secondary bg-green-600 hover:bg-green-700 border-0"
            data-cta="emergency-whatsapp"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654z"/>
            </svg>
            WhatsApp ons direct
          </a>
          <p class="text-xs text-brand-blue-900/60 mt-3 text-center">Ook 's avonds en in het weekend bereikbaar</p>
        </div>
      </div>
    </div>
  </div>
  <div class="absolute -left-20 -bottom-20 w-96 h-96 rounded-full bg-brand-yellow-500/10 blur-3xl pointer-events-none" aria-hidden="true"></div>
</section>
